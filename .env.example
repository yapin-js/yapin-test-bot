# Copy to .env and run: node --env-file=.env bot.js
YAPIN_TOKEN=yb_your_token_here

# Optional: extra owner user ids, comma separated (the bot's owner always counts)
OWNER_IDS=
# Optional: the role /needrole asks for
TEST_ROLE=Tester
# Optional: post a welcome card here when someone joins
WELCOME_CHANNEL_ID=
# Optional: debug for everything
LOG_LEVEL=info
